# Database for local demo
REROUTE_DATABASE_URL=sqlite:///./reroute.db

# Razorpay Test Mode keys - used by app/integrations/razorpay.py for the storefront
# and approved recovery payment links. Never use an rzp_live_ key here.
# Get from Razorpay Dashboard > Settings > API Keys (Test mode)
# Both forms work: REROUTE_ prefix or plain RAZORPAY_. Plain form matches checklist.
RAZORPAY_KEY_ID=rzp_test_example123
RAZORPAY_KEY_SECRET=your_test_secret_here
REROUTE_RAZORPAY_KEY_ID=rzp_test_example123
REROUTE_RAZORPAY_KEY_SECRET=your_test_secret_here

# Webhook HMAC secret for POST /api/v1/webhooks/razorpay
# Generate from Razorpay Dashboard > Settings > Webhooks > Add New Webhook
# Check events: payment.failed and payment.captured
REROUTE_RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-mode-webhook-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-mode-webhook-secret

# OpenRouter key for optional FindingAnalysis generation. Never commit a real key.
# Missing credentials safely persist the deterministic fallback.
OPENROUTER_API_KEY=replace-with-openrouter-key
REROUTE_OPENROUTER_API_KEY=replace-with-openrouter-key
REROUTE_OPENROUTER_TIMEOUT_SECONDS=10
# Optional attribution header for OpenRouter ranking.
REROUTE_OPENROUTER_HTTP_REFERER=

# Tooling - not used by the app directly
# CLI reads ~/.razorpay/config.yaml via `razorpay configure`
# MCP reads RAZORPAY_BASIC_TOKEN (base64 of key_id:key_secret) via ~/.config/opencode/opencode.json
# Test key CSV (rzp-test-key.csv) is gitignored, do not commit it. See docs/razorpay-tooling.md
