# Local default. For Vercel + Supabase, replace this with the Supabase
# Transaction pooler connection string from Project > Connect (port 6543).
# Keep the password inside the URL; do not commit a real value.
REROUTE_DATABASE_URL=sqlite:///./reroute.db

# Razorpay Test Mode only. Never use rzp_live_ credentials for this demo.
REROUTE_RAZORPAY_KEY_ID=rzp_test_example123
REROUTE_RAZORPAY_KEY_SECRET=your_test_secret_here

# Create this value yourself when adding the Razorpay Test Mode webhook.
# Use the exact same secret in Razorpay and Vercel.
# Webhook URL after deployment:
# https://YOUR-VERCEL-DOMAIN/api/v1/webhooks/razorpay
# Events: payment.failed and payment.captured
REROUTE_RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-mode-webhook-secret

# Optional FindingAnalysis provider. Missing credentials safely fall back to
# the deterministic analysis path.
REROUTE_OPENROUTER_API_KEY=replace-with-openrouter-key

# Optional OpenRouter settings. Defaults are already safe if omitted.
# REROUTE_OPENROUTER_TIMEOUT_SECONDS=10
# REROUTE_OPENROUTER_HTTP_REFERER=

# Supabase publishable keys are not required by this backend. ReRoute talks
# to Postgres through REROUTE_DATABASE_URL using SQLAlchemy.
